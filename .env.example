# ============================================================
# saham-indonesia — Environment Configuration
# Copy to `.env` and fill in the API keys you use.
# ============================================================

# --- Default data source preference (fallback chain) ---
# Comma-separated list, tried in order. Options:
#   yahoo, rti, itick, goapi, sectors, stockbit
SAHAM_ID_DATA_SOURCES=yahoo,rti

# --- Yahoo Finance (yfinance) ---
# No API key required. Delayed ~15 minutes.
# Nothing to configure.

# --- RTI / Pasardana scraper ---
# No API key required. Delayed ~15 minutes.
# NOTE: respect robots.txt & ToS. Use with reasonable rate limits.
SAHAM_ID_RTI_RATE_LIMIT_PER_MIN=30

# --- iTick (https://itick.org) ---
# Free tier available. Realtime quotes + WebSocket streaming.
# Get your key at https://itick.org
ITICK_API_KEY=

# --- GoAPI (https://goapi.io) ---
# Freemium. Indonesian provider, IDX-focused.
GOAPI_API_KEY=

# --- Sectors.app / Supertype (https://sectors.app) ---
# Paid ($49/mo+). Rich fundamental & sector data.
SECTORS_API_KEY=

# --- Cache & logging ---
SAHAM_ID_CACHE_DIR=./data/cache
SAHAM_ID_LOG_LEVEL=INFO
