# ============================================================
# saham-indonesia — Environment Configuration
# ============================================================
# Copy to `.env` and fill in the API keys you use.
# Only yfinance works without any API key.
# ============================================================

# --- Default data source preference (fallback chain) ---
# Comma-separated list, tried in order when no source is specified.
# Options: yahoo, rti, itick, goapi, sectors
SAHAM_ID_DATA_SOURCES=yahoo,rti

# --- Yahoo Finance (yfinance) ---
# No API key required. Delayed ~15 minutes.
# Best for: daily OHLC, limited intraday (last 7 days 1m bars).

# --- RTI Business (rti.co.id) ---
# No API key required. Delayed ~15 minutes.
# Respects rate limiting to be polite to the server.
SAHAM_ID_RTI_RATE_LIMIT_PER_MIN=30

# --- iTick (https://itick.org) ---
# Free tier available. Realtime quotes + WebSocket streaming.
# Get your key at: https://itick.org/register
# Supports: REST quotes, intraday klines (1m/5m/15m/30m/60m), WebSocket ticks
ITICK_API_KEY=

# --- GoAPI (https://goapi.io) ---
# Freemium. Indonesian provider, IDX-focused.
# Get your key at: https://goapi.io
# Supports: quotes, OHLC, top gainers/losers/most active
GOAPI_API_KEY=

# --- Sectors.app / Supertype (https://sectors.app) ---
# Paid ($49/mo+). Premium financial data layer for IDX.
# Get your key at: https://sectors.app/pricing
# Supports: quotes, OHLC, full fundamental data (PER, PBV, ROE, DER, etc.)
SECTORS_API_KEY=

# --- Cache & Storage ---
# Directory for caching API responses (reduces redundant requests)
SAHAM_ID_CACHE_DIR=./data/cache
# Enable/disable caching globally (true/false)
SAHAM_ID_CACHE_ENABLED=true
# Maximum items in memory cache
SAHAM_ID_CACHE_MEMORY_MAXSIZE=1024
# Default TTL for cache entries (seconds)
SAHAM_ID_CACHE_DEFAULT_TTL=300
# Enable/disable disk-based cache persistence
SAHAM_ID_CACHE_DISK_ENABLED=true

# --- Retry settings ---
# Max retry attempts for failed data source requests
SAHAM_ID_RETRY_MAX_ATTEMPTS=3
# Min wait between retries (seconds, exponential backoff)
SAHAM_ID_RETRY_MIN_WAIT=1.0
# Max wait between retries (seconds)
SAHAM_ID_RETRY_MAX_WAIT=30.0

# --- Notifications ---
# Telegram bot for real-time alerts (optional)
# Create bot via @BotFather, get chat_id via @userinfobot
SAHAM_ID_TELEGRAM_TOKEN=
SAHAM_ID_TELEGRAM_CHAT_ID=

# Discord webhook URL (optional)
# Server Settings → Integrations → Webhooks → New Webhook → Copy URL
SAHAM_ID_DISCORD_WEBHOOK=

# Generic webhook (Slack-compatible, optional)
SAHAM_ID_WEBHOOK_URL=

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
SAHAM_ID_LOG_LEVEL=INFO
